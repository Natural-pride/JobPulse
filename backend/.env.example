# Backend env vars. Copy to `.env` and fill in.

# HTTP port (default 3001)
# PORT=3001

# SQLite database file path (default backend/data/jobpulse.db)
# DB_PATH=...

# Required for the screenshot import feature (POST /api/parse-screenshot).
# Get a key at https://open.bigmodel.cn/usercenter/apikeys
# ZHIPU_API_KEY=...

# Optional: override the model. Default: glm-4v-plus
# Other options: glm-4v, glm-4v-flash
# ZHIPU_MODEL=glm-4v-plus
